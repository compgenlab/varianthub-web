# Copy to .env and edit. Every value here has a working default, so .env is
# optional — it exists for pointing the stack at real disks and real secrets.

# Absolute host path for downloaded source data, bind-mounted at /mnt/storage.
# Leave unset to use a docker named volume instead. Reference data runs to
# hundreds of gigabytes (dbSNP ~24 GB, phyloP ~6 GB), so a dedicated disk is
# usually what you want.
#VHW_HOST_STORAGE=/mnt/data1/working/varhub-web-storage

# Additional download targets, "name=/abs/path", comma-separated; first is the
# default. Each must be mounted into the worker.
#VHW_STORAGE_PATHS=default=/mnt/storage

#POSTGRES_PASSWORD=devpassword
#VHW_MASTER_KEY=dev-master-key-change-me
#API_PORT=18080
#POSTGRES_PORT=55441

# --- Optional S3-compatible storage (versitygw) -----------------------------
# Off unless you ask for it. Enable the profile AND declare the bucket as a
# storage target; the endpoint is what points varhub at the local gateway
# rather than at AWS.
#
#   COMPOSE_PROFILES=s3
#   VHW_STORAGE_S3=test-bucket=s3://varhub-dev
#   AWS_ENDPOINT_URL=http://s3:7070
#
# The bucket is a directory under S3_HOST_DIR, so you can inspect it with ls.
# Credentials below are the gateway's root keys; they are dev values and the
# gateway is not exposed beyond the compose network plus S3_PORT.
#
# S3_HOST_DIR=/mnt/data1/working/varhub-web-versitygw
# S3_BUCKET=varhub-dev
# S3_PORT=17070
# AWS_ACCESS_KEY_ID=varhubdev
# AWS_SECRET_ACCESS_KEY=varhubdevsecret
# AWS_REGION=us-east-1
