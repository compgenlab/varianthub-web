# Copy to .env and edit. Every value here has a working default, so .env is
# optional — it exists for pointing the stack at real disks and real secrets.

# Absolute host path for downloaded source data, bind-mounted at /mnt/storage.
# Leave unset to use a docker named volume instead. Reference data runs to
# hundreds of gigabytes (dbSNP ~24 GB, phyloP ~6 GB), so a dedicated disk is
# usually what you want.
#VHW_HOST_STORAGE=/mnt/data1/working/varhub-web-storage

# Additional download targets, "name=/abs/path", comma-separated; first is the
# default. Each must be mounted into the worker.
#VHW_STORAGE_PATHS=default=/mnt/storage

#POSTGRES_PASSWORD=devpassword
#VHW_MASTER_KEY=dev-master-key-change-me
#API_PORT=18080
#POSTGRES_PORT=55441
